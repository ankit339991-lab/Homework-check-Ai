{
  "name": "homework-chek-ai",
  "version": "1.0.0",
  "description": "AI-powered Homework Checker using APInex models with Image & Text support",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "server": "node server.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client install && npm --prefix client run build",
    "dev": "concurrently \"node server.js\" \"npm --prefix client run dev\""
  },
  "keywords": [
    "homework",
    "ai",
    "checker",
    "vision",
    "ocr",
    "tutor",
    "apinex"
  ],
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
